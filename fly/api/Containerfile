# Uro for Fly.
FROM docker.io/library/elixir:1.17-otp-27
RUN apt-get update && apt-get install -y --no-install-recommends \
      cmake ninja-build build-essential git curl ca-certificates python3 \
 && rm -rf /var/lib/apt/lists/*
ENV MIX_ENV=prod
WORKDIR /app
RUN mix local.hex --force && mix local.rebar --force
COPY mix.exs mix.lock ./
COPY apps ./apps
RUN mix do deps.get, patch.exmarcel, deps.compile
COPY config ./config
COPY priv ./priv
COPY lib ./lib
COPY Makefile ./
COPY c_src ./c_src
RUN mix compile
# The web image copies this spec from here at build time.
# runtime.exs demands deploy secrets under prod; these placeholders exist only for this step.
RUN mkdir -p frontend/src/__generated && \
    URL=http://localhost ROOT_ORIGIN=http://localhost FRONTEND_URL=http://localhost \
    PHOENIX_KEY_BASE=build JOKEN_SIGNER=build \
    mix openapi.spec.json --spec Uro.OpenAPI.Specification --pretty --vendor-extensions=false --start-app=false \
      ./frontend/src/__generated/openapi.json
COPY fly/api/entry.sh /entry.sh
ENV UPLOAD_STORAGE=local \
    PORT=4000
EXPOSE 4000
ENTRYPOINT ["/bin/sh", "/entry.sh"]
